source 309 "﻿swang 1\n\npattern p {\n    ascii \"X.X/XX./.XX\"\n    |> fractalize depth 1 max_cells 4096\n    |> linearize snake\n    |> map_rhythm unit 1/16 tail rest_pad\n    |> generate {\n        source \"seed.gp5\"\n        bars 8\n        seed 42\n        candidates 2\n        strategy auto\n    }\n    |> export midi \"out.mid\"\n}\n"
verdict rejected
diagnostic 0 SWG0003 0 3 63 "byte-order mark before the header; Swang is UTF-8 without a BOM"
end

