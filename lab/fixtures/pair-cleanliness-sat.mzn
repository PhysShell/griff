% griff-constraint-lab problem "pair-cleanliness" fingerprint 9e16ec2f3325f445
% generated by the offline Constraint Lab spike

var {64,66,67,69,71,72,74,76}: b0;
var {64,66,67,69,71,72,74,76}: b1;
var {64,66,67,69,71,72,74,76}: b2;
var {64,66,67,69,71,72,74,76}: b3;

constraint forall(c in {1,6,11})((abs(b0 - 52) mod 12) != c);
constraint forall(c in {1,6,11})((abs(b1 - 55) mod 12) != c);
constraint forall(c in {1,6,11})((abs(b2 - 52) mod 12) != c);
constraint forall(c in {1,6,11})((abs(b3 - 57) mod 12) != c);
constraint let { var int: b_lo = min([b0,b1,b2,b3]);
                 var int: b_hi = max([b0,b1,b2,b3]);
                 var int: i_lo = max(52, b_lo);
                 var int: i_hi = min(57, b_hi);
                 var int: ov = max(0, i_hi - i_lo);
                 var int: narrower = min(57 - 52, b_hi - b_lo) } in
  if narrower == 0 then i_hi < i_lo else ov * 2 <= narrower * 1 endif;

solve satisfy;
output ["b0=", show(b0), "\n", "b1=", show(b1), "\n", "b2=", show(b2), "\n", "b3=", show(b3), "\n"];
