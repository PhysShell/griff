% griff-constraint-lab problem "pair-cleanliness" fingerprint da18bcc5cfc2548b
% generated by the offline Constraint Lab spike

var {48,50,52}: b0;
var {48,50,52}: b1;

constraint let { var int: b_lo = min([b0,b1]);
                 var int: b_hi = max([b0,b1]);
                 var int: i_lo = max(45, b_lo);
                 var int: i_hi = min(57, b_hi);
                 var int: ov = max(0, i_hi - i_lo);
                 var int: narrower = min(57 - 45, b_hi - b_lo) } in
  if narrower == 0 then i_hi < i_lo else ov * 2 <= narrower * 1 endif;

solve satisfy;
output ["b0=", show(b0), "\n", "b1=", show(b1), "\n"];
